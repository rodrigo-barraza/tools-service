{
  "name": "tools-service",
  "version": "0.2.0",
  "description": "Unified data aggregator API — events, market, products, trends, weather",
  "type": "module",
  "main": "src/boot.ts",
  "scripts": {
    "start": "node src/boot.ts",
    "dev": "node --watch src/boot.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "deploy": "bash deploy.sh",
    "deploy:dry": "bash deploy.sh --dry-run"
  },
